# ── Shared environment (used by Docker Compose + Next.js) ──
# Copy this file to .env and adjust values.
# Docker Compose reads .env automatically; Next.js loads it via dotenv-cli.

POSTGRES_USER=testuser
POSTGRES_PASSWORD=testpassword

POSTGRES_PRISMA_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/darts-test"
POSTGRES_URL_NON_POOLING="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/darts-test"

# Optional CueScore provider selection.
# In development, the app automatically falls back to the local fake provider
# when CueScore credentials are not set.
# CUESCORE_PROVIDER=fake
# CUESCORE_USERNAME=
# CUESCORE_PASSWORD=

# Admin UI credentials for /admin
# ADMIN_UI_USERNAME=
# ADMIN_UI_PASSWORD=
